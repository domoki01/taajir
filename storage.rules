rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// taajir — Cloud Storage security rules
//
// Listing photos are the product, so they are world-readable. Payment receipts
// and agency legal documents are not: a CCP receipt carries an account number.
// ─────────────────────────────────────────────────────────────────────────────

service firebase.storage {
  match /b/{bucket}/o {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn()
             && (request.auth.token.get('role', '') == 'admin'
                 || request.auth.token.get('role', '') == 'moderator');
    }

    function isImage() {
      return request.resource.contentType.matches('image/(jpeg|png|webp)');
    }

    function underMb(mb) {
      return request.resource.size < mb * 1024 * 1024;
    }

    // Storage rules can read Firestore, which is the only place the owner of an
    // agency is recorded. One lookup per write, on a path written rarely.
    function ownsAgency(agencyId) {
      return signedIn()
             && firestore.get(/databases/(default)/documents/agencies/$(agencyId))
                  .data.ownerUid == request.auth.uid;
    }

    // ── LISTING PHOTOS ───────────────────────────────────────────────────────
    // Written straight from the browser after the server has checked the user's
    // quota and issued the path. Uploads are pinned under the uploader's own
    // uid, so one user cannot write into another's namespace. The client
    // downscales to 1920px WebP before uploading, so 6 MB is a generous ceiling
    // rather than an expected size.

    match /listings/{userId}/{listingId}/{fileName} {
      allow read: if true;
      allow write: if signedIn() && request.auth.uid == userId
                   && isImage() && underMb(6);
    }

    // ── ADVERTISING BANNERS ──────────────────────────────────────────────────
    // Uploaded straight from the admin screen, then recorded in Firestore by a
    // Server Action. Staff-only: this path is the home page's first image, so
    // write access to it is write access to the front of the site.

    match /promos/{fileName} {
      allow read: if true;
      allow write: if isAdmin() && isImage() && underMb(4);
    }

    // ── AGENCY BRANDING ──────────────────────────────────────────────────────
    // Pinned to the agency's own owner. `signedIn()` alone meant any account on
    // the site could overwrite any agency's logo and cover — the images that
    // appear on that agency's public page — which is defacement of somebody
    // else's business by anyone who can register.

    match /agencies/{agencyId}/public/{fileName} {
      allow read: if true;
      allow write: if ownsAgency(agencyId) && isImage() && underMb(4);
    }

    // ── PRIVATE DOCUMENTS ────────────────────────────────────────────────────
    // Transfer receipts and agrément scans. The uploader may read back what
    // they submitted; otherwise admins only.

    match /receipts/{userId}/{fileName} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow write: if signedIn() && request.auth.uid == userId
                   && (isImage()
                       || request.resource.contentType == 'application/pdf')
                   && underMb(6);
    }

    // The agrément scan. Same ownership check, and — unlike before — a type:
    // `signedIn() && underMb(6)` accepted **any** content type from **any**
    // account into **any** agency's folder, which is an arbitrary file host
    // inside the project's own bucket, and an HTML file there is a page served
    // from a Google domain that an admin is invited to open.

    match /agencies/{agencyId}/legal/{fileName} {
      allow read: if isAdmin() || ownsAgency(agencyId);
      allow write: if ownsAgency(agencyId)
                   && (isImage()
                       || request.resource.contentType == 'application/pdf')
                   && underMb(6);
    }

    // ── DEFAULT DENY ─────────────────────────────────────────────────────────

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
