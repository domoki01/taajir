rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────────
// taajir — Firestore security rules
//
// This Firebase project (newmokit) is SHARED with the catalogev product, whose
// rules were only ever set in the console and never version-controlled.
// Deploying this file replaces everything, so the catalog rules are restated
// at the bottom. Removing that block silently breaks a live app.
//
// Design note: clients never write `listings`. Every create, edit and
// moderation goes through a Server Action on the Admin SDK, which is what makes
// quota enforcement and the paid promotion flags tamper-proof. A whitelist of
// writable fields would have to be exactly right forever; denying the whole
// collection only has to be right once.
// ─────────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── HELPERS ──────────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Read from the custom claim, not from a users/ document: a get() inside a
    // rule costs a billable read on every evaluation and is capped at ten
    // lookups per request, while the claim rides along in the token for free.
    function role() {
      return signedIn() ? request.auth.token.get('role', 'user') : 'visitor';
    }

    function isAdmin() {
      return role() == 'admin' || role() == 'moderator';
    }

    function isOwner(userId) {
      return signedIn() && uid() == userId;
    }

    function notBanned() {
      return signedIn() && request.auth.token.get('banned', false) == false;
    }

    function onlyChanged(allowed) {
      return request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(allowed);
    }

    // ── LISTINGS ─────────────────────────────────────────────────────────────
    // Public read of published ads only. Owners see their own drafts and
    // rejections so the dashboard can show live status. All writes denied —
    // see the design note above.

    match /listings/{listingId} {
      // Field access uses .get() with a default rather than a bare property
      // read. On a `list`, the rule is evaluated per candidate document and a
      // single document missing the field raises "property is undefined" and
      // denies the entire query — so a half-written ad would take every browse
      // page down. A `get` never hits this, which is why it only shows up once
      // the collection is queried rather than read by id.
      allow read: if resource.data.get('status', '') == 'published'
                  || isOwner(resource.data.get('ownerUid', ''))
                  || isAdmin();
      allow create, update, delete: if false;

      // ── COMMENTS ───────────────────────────────────────────────────────────
      // Public read of visible comments, so the thread is indexable and can
      // later be made realtime from the client without touching rules again.
      // Writes are denied for the same reason as the listing itself: the
      // author name, photo and the "صاحب الإعلان" badge are denormalized from
      // the verified session by a Server Action. If a client could write here
      // it could post as anyone, and the badge that tells a buyer they are
      // talking to the actual owner would mean nothing.
      match /comments/{commentId} {
        // Same .get() defence as above — one comment written before the
        // `status` field existed would otherwise deny the whole thread query.
        allow read: if resource.data.get('status', '') == 'visible'
                    || isOwner(resource.data.get('authorUid', ''))
                    || isAdmin();
        allow create, update, delete: if false;
      }
    }

    // ── USERS ────────────────────────────────────────────────────────────────
    // A user edits their own profile. Role, quota, counters and ban state are
    // server territory — a user who could raise their own listingQuota would
    // make the paid plans pointless.

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // No client create. The document is written by ensureUserDoc on the
      // Admin SDK during the session exchange, and the previous rule — which
      // only pinned role, isBanned and activeListingCount — left `listingQuota`
      // and `approved` free. A client signs in with the JS SDK *before* it
      // posts its token here, so in that window it could write its own document
      // with a quota of ten thousand and approved: true, and ensureUserDoc,
      // finding a document already there, would leave both alone. The paid tier
      // and the registration gate are that field and that flag.
      allow create: if false;

      allow update: if isAdmin()
                    || (isOwner(userId) && notBanned() && onlyChanged([
                          'displayName', 'photoURL', 'phone', 'wilayaCode',
                          'locale', 'notifyOnMessage', 'notifyOnSavedSearch',
                          'lastSeenAt'
                       ]));

      allow delete: if isAdmin();

      match /favorites/{listingId} {
        allow read, write: if isOwner(userId) && notBanned();
      }

      // ── PUSH DEVICES ───────────────────────────────────────────────────────
      // One document per browser that agreed to receive notifications, holding
      // its FCM registration token. Written only by a Server Action, which
      // attaches the token to the session that presented it — a client-writable
      // version would let anyone point someone else's account at their own
      // device, or read the tokens needed to impersonate a delivery target.
      match /devices/{deviceId} {
        allow read, write: if false;
      }
    }

    // ── AGENCIES ─────────────────────────────────────────────────────────────
    // Public read of active agencies. The owner edits presentation only:
    // isVerified drives the "موثّق" badge and is granted by an admin against a
    // recorded agrément number, never self-assigned.

    match /agencies/{agencyId} {
      allow read: if resource.data.status == 'active'
                  || isOwner(resource.data.ownerUid)
                  || isAdmin();

      allow create: if false;

      allow update: if isAdmin()
                    || (isOwner(resource.data.ownerUid) && notBanned()
                        && onlyChanged([
                             'name', 'nameFr', 'description', 'logoUrl',
                             'coverUrl', 'phones', 'whatsapp', 'email',
                             'website', 'address', 'wilayaCode', 'communeSlug',
                             'geo', 'feeSchedule'
                           ]));

      allow delete: if isAdmin();
    }

    // ── PROMOS ───────────────────────────────────────────────────────────────
    // The advertising banners on the home page. Public read of the active ones;
    // writes are staff-only and go through a Server Action, so the client is
    // denied here the same way it is for listings. A client that could write
    // this collection could put any image and any link on the front page.

    match /promos/{promoId} {
      // .get() with a default, as everywhere else: the home page *queries* this
      // collection, and a document missing isActive would deny the whole query
      // and take the strip down.
      allow read: if resource.data.get('isActive', false) == true || isAdmin();
      allow create, update, delete: if false;
    }

    // ── PROPERTY REQUESTS ────────────────────────────────────────────────────
    // The demand feed. Public read of visible posts so the feed is indexable;
    // all writes denied, as everywhere else content is denormalized.
    //
    // The reply's attached listing is the reason this cannot be relaxed later:
    // it carries a title, a price and a link, all denormalized. A client that
    // could write a reply could staple any title to any link and put it under
    // someone else's request, which is an advertisement wearing a neighbour's
    // name.

    match /requests/{requestId} {
      // .get() with a default rather than a bare property read: the feed
      // *queries* this collection, and one document missing `status` would
      // raise "property is undefined" and deny the whole query — taking the
      // feed down rather than hiding one post.
      allow read: if resource.data.get('status', '') == 'visible'
                  || isOwner(resource.data.get('ownerUid', ''))
                  || isAdmin();
      allow create, update, delete: if false;

      // Named `replies`, not `comments`: the moderation screen runs a
      // collection-group query over `comments`, and a second collection by that
      // name would pour these into a list whose every link points at a listing
      // that does not exist.
      match /replies/{replyId} {
        allow read: if resource.data.get('status', '') == 'visible'
                    || isOwner(resource.data.get('authorUid', ''))
                    || isAdmin();
        allow create, update, delete: if false;
      }
    }

    // ── SITE SETTINGS ────────────────────────────────────────────────────────
    // The categories the filter offers, the site's name and palette, the launch
    // switch, the roles table and the registration-approval flag.
    //
    // Nothing here is written by a client, ever. Every one of these documents
    // decides what somebody else is allowed to do or see — a role's permissions
    // most obviously — so they go through Server Actions on the Admin SDK, which
    // check the caller's permission and validate every field before writing.
    // Denying the whole collection is one line and cannot be got wrong; a
    // per-field whitelist is a rule that has to be right every time it changes.
    //
    // `filter`, `branding` and `launch` stay publicly readable: the front page
    // renders all three, they are config rather than secrets, and a future
    // client-side filter would need them. `roles` and `access` are not — they
    // describe the site's internal structure to no one who needs it.

    match /settings/{docId} {
      allow read: if docId == 'filter'
                  || docId == 'branding'
                  || docId == 'launch'
                  || isAdmin();
      allow create, update, delete: if false;
    }

    // ── LAUNCH OUTBOX ────────────────────────────────────────────────────────
    // One row per person per channel, holding an email address or a phone
    // number. That is a mailing list of every registered user, which is exactly
    // the thing worth stealing from a classifieds site — so no client reads it,
    // staff included, and nothing writes it but the launch.

    match /launchOutbox/{entryId} {
      allow read, write: if false;
    }

    // ── PLANS ────────────────────────────────────────────────────────────────

    match /plans/{planId} {
      allow read: if resource.data.isActive == true || isAdmin();
      allow write: if false;
    }

    // ── SUBSCRIPTIONS ────────────────────────────────────────────────────────

    match /subscriptions/{subId} {
      allow read: if isAdmin() || isOwner(resource.data.subjectId);
      allow write: if false;
    }

    // ── PAYMENTS ─────────────────────────────────────────────────────────────
    // The payer submits a transfer receipt and reads their own records. Moving
    // a payment to 'paid' is the act that grants a paid subscription, so it is
    // admin-only — and later, the same transition will be performed by the
    // payment-gateway webhook through the Admin SDK, not by a client.

    match /payments/{paymentId} {
      allow read: if isAdmin() || isOwner(resource.data.subjectId);

      allow create: if notBanned()
                    && request.resource.data.subjectId == uid()
                    && request.resource.data.status == 'awaitingReview'
                    && request.resource.data.provider in
                       ['manual_ccp', 'manual_baridimob', 'manual_bank']
                    && request.resource.data.createdAt == request.time;

      allow update, delete: if false;
    }

    // ── SAVED SEARCHES ───────────────────────────────────────────────────────
    // These documents decide who gets a push, so they are server territory. The
    // label is derived, the count is capped, and duplicates are rejected — all
    // in a Server Action. A client that could create them could subscribe an
    // account to everything on the site, which is a spam cannon aimed at a real
    // person's phone.
    //
    // Reads go through the Admin SDK too: what someone is looking for is nobody
    // else's business, and no client ever needs to query this collection.

    match /savedSearches/{id} {
      allow read: if isOwner(resource.data.get('ownerUid', '')) || isAdmin();
      allow create, update, delete: if false;
    }

    // ── MESSAGING ────────────────────────────────────────────────────────────
    // Threads are opened by a Server Action, which checks the listing is
    // published and that its owner accepts messages. Participants then talk
    // directly through the client SDK so the thread is realtime.

    match /conversations/{convId} {
      function isParticipant() {
        return signedIn() && uid() in resource.data.participantUids;
      }

      allow read: if isParticipant() || isAdmin();
      allow create: if false;
      allow update: if isAdmin()
                    || (isParticipant() && notBanned()
                        && onlyChanged(['lastMessage', 'unread', 'updatedAt']));
      allow delete: if false;

      match /messages/{msgId} {
        function inConversation() {
          return signedIn() && uid() in
            get(/databases/$(database)/documents/conversations/$(convId))
              .data.participantUids;
        }

        allow read: if inConversation() || isAdmin();

        allow create: if inConversation() && notBanned()
                      && request.resource.data.senderUid == uid()
                      && request.resource.data.sentAt == request.time
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 2000;

        allow update: if inConversation() && onlyChanged(['readAt']);
        allow delete: if isAdmin();
      }
    }

    // ── REPORTS ──────────────────────────────────────────────────────────────
    // Flagging a fake ad should stay easy — it is the standard failure mode of
    // a classifieds site — but the rule that allowed it was an unauthenticated
    // write endpoint with no shape at all: anything could POST documents of any
    // size, as fast as it liked, into a billed collection. Nothing in the app
    // writes here yet, so the flow will arrive the way every other write does,
    // through a Server Action that can also rate-limit and deduplicate.

    match /reports/{id} {
      allow create: if false;
      allow read, update, delete: if isAdmin();
    }

    // ── NOTIFICATIONS ────────────────────────────────────────────────────────

    match /notifications/{userId}/items/{id} {
      allow read: if isOwner(userId);
      allow update: if isOwner(userId) && onlyChanged(['isRead']);
      allow create, delete: if false;
    }

    // ── AUDIT AND AGGREGATES ─────────────────────────────────────────────────

    match /adminAudit/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /counters/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ── RATE LIMITS ──────────────────────────────────────────────────────────
    // One rolling document per account and action, written by the Server Action
    // that enforces the limit. A client that could read it would know exactly
    // how much room it had left; one that could write it would have no limit at
    // all — so neither, including staff.

    match /rateLimits/{id} {
      allow read, write: if false;
    }

    // ── BROADCASTS ───────────────────────────────────────────────────────────
    // What the site announced to everyone, when, and by whom. Written by the
    // Server Action that sends it and read back on the admin screen through the
    // Admin SDK — no client needs either half.

    match /broadcasts/{id} {
      allow read, write: if false;
    }

    // ── REFERRALS ────────────────────────────────────────────────────────────
    // The whole programme is server territory, and this is the collection set
    // where a writable field would be worth actual money.
    //
    // `pointsLedger` is the record of every point granted and spent — the user
    // document's balance is a cache of it. A client that could append a row
    // could not move its own balance, but it could make a dispute unanswerable,
    // which is what the ledger exists to prevent.
    //
    // `payouts` carries a RIP number and a RedotPay id. Nobody but the owner
    // and the admin has business reading a bank account number, and the pages
    // that show them are Server Components on the Admin SDK.
    //
    // `campaigns/entrants` is a leaderboard; a client that could bump a counter
    // would simply win. It is rendered server-side for the same reason.
    //
    // `referralCodes` maps a code to the uid behind it. Readable, it turns the
    // six-character space into an enumerable directory of every account on the
    // site; writable, it lets anyone claim someone else's code.

    match /pointsLedger/{id} {
      allow read, write: if false;
    }

    match /payouts/{id} {
      allow read, write: if false;
    }

    match /campaigns/{id} {
      allow read, write: if false;

      match /entrants/{uid} {
        allow read, write: if false;
      }
    }

    match /referralCodes/{code} {
      allow read, write: if false;
    }

    // ── CATALOGEV (shared project — DO NOT REMOVE) ───────────────────────────
    // The product catalogue lives in the same Firebase project. Its rules were
    // never committed anywhere, so they are restated here: without this block a
    // taajir deploy takes that app down.

    // Verified against the deployed ruleset before the first taajir deploy, and
    // reproduced exactly — note the recursive `{doc=**}` rather than a single
    // segment, so any subcollection under a catalog document keeps working.
    match /catalog/{doc=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ── DEFAULT DENY ─────────────────────────────────────────────────────────

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
