APP_NAME="تأجير"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Arabic is the site's own language and the one with no URL prefix. French and
# English are reached at /fr and /en; see App\Enums\Locale. config/app.php
# defaults to 'ar' as well, so forgetting this here cannot serve the whole site
# in the wrong language.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_DZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL in every environment that matters — the whole point of the port is the
# ranges, sorts and joins Firestore refused. sqlite is fine for `php artisan
# test`, which is why phpunit.xml overrides this; it is not fine for the site,
# because FULLTEXT search does not exist there.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taajir
DB_USERNAME=root
DB_PASSWORD=

# Sessions on disk, like the cache: shared hosting has no Redis, and the
# framework's sessions table shipped inside the password-auth migration this
# port does not use.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Shared hosting has no Redis, so the file driver is the cache. Page caching
# (the listing page, articles, the sitemap) is explicit here — there is no ISR
# to do it for free.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── تأجير ────────────────────────────────────────────────────────────────────

# Absolute origin used by canonical URLs, the sitemap and OG tags. Defaults to
# APP_URL when unset.
TAAJIR_SITE_URL=

# Whether the phone door exists at all. Off by default, so the sign-in page is
# one Google button and no number is ever typed into this site. Turn it on the
# day the Firestore users are imported: thirty-five of them have a number and no
# email, and with this off they have no way in — `taajir:import` counts them and
# refuses to be quiet about it. "off" or anything else.
TAAJIR_PHONE_SIGNIN=off

# The narrower switch inside it: whether a *new* account may be opened by phone.
# Only consulted when TAAJIR_PHONE_SIGNIN is on. "off" lets the thirty-five back
# in without opening the site to bulk SIM registrations.
TAAJIR_PHONE_SIGNUP=off

# Search Console's ownership token, emitted as a <meta> tag. Empty is valid: the
# tag is simply not emitted, which is better than an empty content attribute.
TAAJIR_GOOGLE_SITE_VERIFICATION=

# ── FIREBASE ─────────────────────────────────────────────────────────────────
# Signing in is the only thing Firebase does for this application. None of these
# are secrets — the browser receives all of them by design; they identify the
# project rather than authorising anything. There is deliberately no service
# account key: the token verifier uses Google's public certificates.
#
# Every one of these has a default in config/firebase.php — the same values the
# Next app committed — so an .env that never mentions Firebase still signs people
# in. Set them only to point this install at a different project (a staging one,
# say). FIREBASE_PROJECT_ID is the audience every ID token is checked against,
# and setting it to the *empty* string is not the same as leaving it out: empty
# refuses every token, which is the right failure but a deliberate one.
# FIREBASE_PROJECT_ID=
# FIREBASE_API_KEY=
# FIREBASE_AUTH_DOMAIN=
# FIREBASE_APP_ID=
# FIREBASE_MESSAGING_SENDER_ID=

# ── THE LAUNCH GATE AND THE CRON ─────────────────────────────────────────────
# The bearer token on GET /api/cron/launch. Empty means that route answers 503
# and the launch stays where it already works: the admin's switch. The
# scheduler's `taajir:launch --if-due` does not need it — it runs as the shell
# user — so this is only for triggering a launch over HTTP.
CRON_SECRET=

# ── NOTIFICATION CHANNELS ────────────────────────────────────────────────────
# None is wired, and each is one variable plus one adapter away. They decide
# whether the admin screen offers to send or says plainly that nothing can be
# delivered yet; a send button that quietly does nothing is worse than none.
#
# FCM is absent on purpose rather than forgotten: sending a push needs a
# Firebase service-account credential on this host, and keeping that off the
# host is why sign-in verifies ID tokens against Google's public certificates
# instead of using the Admin SDK. Until a channel exists that needs no such key,
# every push row waits in `launch_outbox`.
EMAIL_PROVIDER_KEY=
SMS_PROVIDER_KEY=
FCM_READY=false

# ── THE INSTALLER AND THE UPDATER ────────────────────────────────────────────
# Guards public_html/setup.php and public_html/update.php, which are how an
# account with no SSH runs migrations. Both refuse to do anything unless this
# is set and long. Generate one and keep it out of the repository:
#
#   openssl rand -hex 24
SETUP_TOKEN=
