# ── RUNTIME ENVIRONMENT FOR THE cPANEL BUNDLE ────────────────────────────────
# Copy to `.env.production` next to app.js on the server and fill in. Never
# commit the filled copy, and never upload it anywhere but the app directory —
# it is not inside public_html, which is the point.

# NEXT_PUBLIC_SITE_URL is NOT here on purpose. Next replaces every
# NEXT_PUBLIC_* lookup with its value while compiling — not one of them
# survives into the running server — so the origin is fixed by the build:
#
#   NEXT_PUBLIC_SITE_URL=https://test.example.com npm run build:cpanel
#
# Setting it here would look like it worked and change nothing. Check which
# origin the uploaded bundle carries in build-info.json.

# Service account JSON, base64-encoded — the whole point of base64 being that
# the key contains newlines and an env file has one line per value:
#   base64 -w0 service-account.json
# Required. Outside Google's infrastructure there is no ambient credential, so
# without this every session cookie, every publish and every moderation fails.
FIREBASE_SERVICE_ACCOUNT_JSON=

# 32 random bytes, base64 — encrypts the RIP / Binance / BaridiMob fields on
# payout and prize records:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Generate it ONCE. A new value does not re-encrypt what is already stored, it
# only makes it unreadable.
FIELD_ENCRYPTION_KEY=

# Shared secret for /api/cron/*. Needed only if you point a cPanel cron job at
# the launch endpoint; unset, that route answers 503 and the launch stays manual.
CRON_SECRET=

# Optional notification providers. Unset means "queued in launchOutbox", never
# "silently dropped".
EMAIL_PROVIDER_KEY=
SMS_PROVIDER_KEY=
