# Solana RPC endpoint. The free public one is heavily rate-limited; use a
# dedicated provider (Helius, Triton, QuickNode) for anything serious.
RPC_URL=https://api.mainnet-beta.solana.com

# Jupiter aggregator API. The lite endpoint is free and keyless but
# rate-limited to roughly one request per second; api.jup.ag needs a key.
JUPITER_BASE_URL=https://lite-api.jup.ag/swap/v1
JUPITER_API_KEY=

# Minimum gap between Jupiter requests. Each token costs 2 quotes per cycle,
# so 3 tokens at 1200ms is about one full cycle every 8s. Lower it only with
# a paid key, or every request comes back 429.
REQUEST_INTERVAL_MS=1200

# DRY_RUN=true (the default) only logs opportunities and never touches funds.
# Set to false ONLY after you have watched the logs and accept the risk.
DRY_RUN=true

# Base58-encoded secret key of the trading wallet. Required only when
# DRY_RUN=false. Use a dedicated wallet holding ONLY what you can lose.
# NEVER commit this file with a real key.
PRIVATE_KEY=

# Round-trip size in USDC.
TRADE_SIZE_USDC=10

# Minimum round-trip edge in basis points (30 = 0.30%) before acting.
# Must at least cover ~2 transaction fees + priority fees + slippage.
MIN_PROFIT_BPS=30

SLIPPAGE_BPS=50
SCAN_INTERVAL_MS=3000

# DEBUG=true logs every retry and backoff.
DEBUG=false

# Comma-separated token mints to scan against USDC (defaults to SOL, JUP, JTO).
TOKENS=
