# ── PUBLIC ───────────────────────────────────────────────────────────────────
# Firebase web config values are public project identifiers, not credentials —
# they ship in the browser bundle by design. Access is gated by firestore.rules
# and storage.rules, which is why those files are version-controlled here.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Web Push public key, from Firebase Console → Project settings → Cloud
# Messaging → Web Push certificates. Public by definition — it is the key the
# browser sends to the push service. No API mints it, so it cannot be scripted.
# Left empty, saved-search alerts are still saved; only the push is switched off.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# Absolute origin. Drives metadataBase, canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── SERVER ONLY ──────────────────────────────────────────────────────────────
# Never prefix these with NEXT_PUBLIC_ — that would publish them to the browser.

# Service account JSON, on one line (or base64-encoded). Used by firebase-admin
# for session cookies, custom claims and every privileged write.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Shared secret guarding /api/cron/* against public invocation. /api/cron/launch
# opens the whole site, so a Cloud Scheduler job calling it must present this as
# a bearer token. Unset, the route answers 503 and the launch stays manual.
CRON_SECRET=

# Launch notifications. The pipeline writes every intended message to the
# `launchOutbox` collection first and only sends on the channels that have a
# provider — so an unset key means "queued, waiting for credentials", never a
# message dropped. Push (FCM) needs neither of these.
EMAIL_PROVIDER_KEY=
SMS_PROVIDER_KEY=

# Email granted the admin claim by `npm run set-admin`. Consumed once.
ADMIN_BOOTSTRAP_EMAIL=

# ── LOCAL DEVELOPMENT ────────────────────────────────────────────────────────
# Point the SDKs at the Firebase emulator suite instead of the live project.
NEXT_PUBLIC_USE_EMULATORS=false
