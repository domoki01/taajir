{
  "name": "taajir",
  "version": "0.1.0",
  "private": true,
  "description": "تاجر — منصة إعلانات كراء وبيع العقارات في الجزائر",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run tests/unit",
    "typecheck": "next typegen && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:rules": "firebase emulators:exec --only firestore --project demo-taajir \"vitest run tests/rules\"",
    "emulators": "firebase emulators:start --project demo-taajir"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "firebase": "12.17.0",
    "firebase-admin": "14.2.0",
    "lucide-react": "1.28.0",
    "next": "16.3.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "firebase-tools": "15.25.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "3.2.7"
  }
}
