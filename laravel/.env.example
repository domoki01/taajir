APP_NAME="تأجير"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Arabic is the site's own language and the one with no URL prefix. French and
# English are reached at /fr and /en; see App\Enums\Locale. config/app.php
# defaults to 'ar' as well, so forgetting this here cannot serve the whole site
# in the wrong language.
APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_DZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL in every environment that matters — the whole point of the port is the
# ranges, sorts and joins Firestore refused. sqlite is fine for `php artisan
# test`, which is why phpunit.xml overrides this; it is not fine for the site,
# because FULLTEXT search does not exist there.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=taajir
DB_USERNAME=root
DB_PASSWORD=

# Sessions on disk, like the cache: shared hosting has no Redis, and the
# framework's sessions table shipped inside the password-auth migration this
# port does not use.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Shared hosting has no Redis, so the file driver is the cache. Page caching
# (the listing page, articles, the sitemap) is explicit here — there is no ISR
# to do it for free.
CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── تأجير ────────────────────────────────────────────────────────────────────

# Absolute origin used by canonical URLs, the sitemap and OG tags. Defaults to
# APP_URL when unset.
TAAJIR_SITE_URL=

# Whether a *new* account may be opened with a phone number. Signing *in* by
# phone is never hidden by this — thirty-five accounts have no email and no
# password, and hiding their only door would strand them. "off" or anything else.
TAAJIR_PHONE_SIGNUP=off

# Search Console's ownership token, emitted as a <meta> tag. Empty is valid: the
# tag is simply not emitted, which is better than an empty content attribute.
TAAJIR_GOOGLE_SITE_VERIFICATION=
